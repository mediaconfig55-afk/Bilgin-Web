---
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import type { JsonLd } from "../lib/schema";
import { absoluteUrl, url } from "../lib/url";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  og?: string;
  ogAlt?: string;
  type?: "website" | "article";
  published?: Date;
  updated?: Date;
  noindex?: boolean;
  schema?: JsonLd;
}

const {
  title,
  description,
  og = "varsayilan",
  ogAlt,
  type = "website",
  published,
  updated,
  noindex = false,
  schema,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = absoluteUrl(`/og/${og}.png`);
const robots = noindex ? "noindex, follow" : "index, follow, max-image-preview:large";
const jsonLd = schema ? JSON.stringify(schema).replace(/</g, "\\u003c") : null;
---

<!doctype html>
<html lang="tr" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={robots} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#fcfcfd" />
    <meta name="format-detection" content="telephone=no" />
    {
      site.googleSiteVerification && (
        <meta name="google-site-verification" content={site.googleSiteVerification} />
      )
    }

    <link rel="icon" href={url("/favicon.ico")} sizes="32x32" />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
    <link rel="manifest" href={url("/site.webmanifest")} />
    <link rel="sitemap" href={url("/sitemap-index.xml")} />

    <Font cssVariable="--font-schibsted" preload />
    <Font cssVariable="--font-instrument" preload={[{ weight: 400 }]} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt ?? title} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip-link" href="#icerik">İçeriğe geç</a>
    <Header />
    <main id="icerik" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
