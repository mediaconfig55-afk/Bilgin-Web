---
// N9 — kenar hizalı sade gezinme. Kutu yok, sadece altta saç teli çizgi.
import { primaryNav, site, whatsappUrl } from "../data/site";
import { url } from "../lib/url";

const here = Astro.url.pathname.replace(/\/+$/, "") + "/";
const isHere = (href: string) => here === url(href).replace(/\/+$/, "") + "/";
---

<header class="mast">
  <div class="wrap mast__row">
    <a class="mast__name" href={url("/")}>{site.name}</a>

    <nav class="mast__nav" aria-label="Ana menü">
      <ul role="list">
        {
          primaryNav.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isHere(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="mast__cta" href={whatsappUrl()}>WhatsApp</a>
    </nav>
  </div>
</header>

<style>
  .mast {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: color-mix(in oklch, var(--color-paper) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: var(--rule-hair) solid var(--color-line);
  }

  .mast__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: 4rem;
  }

  .mast__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-md);
    letter-spacing: var(--tracking-heading);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .mast__nav {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .mast__nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding: 0;
    margin: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .mast__nav ul a {
    display: block;
    padding-block: var(--space-sm);
    color: var(--color-muted);
    text-decoration: none;
    white-space: nowrap;
    line-height: 1;
  }

  .mast__nav ul a:hover {
    color: var(--color-ink);
  }

  .mast__nav ul a[aria-current="page"] {
    color: var(--color-ink);
    font-weight: 600;
  }

  .mast__cta {
    padding: var(--space-xs) var(--space-md);
    border: var(--rule-hair) solid var(--color-accent);
    border-radius: var(--radius-sm);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--dur-short) var(--ease-out),
      color var(--dur-short) var(--ease-out);
  }

  .mast__cta:hover {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  @media (max-width: 30rem) {
    .mast__nav {
      gap: var(--space-sm);
    }

    .mast__nav ul {
      gap: var(--space-md);
      font-size: var(--text-xs);
    }

    .mast__cta {
      padding-inline: var(--space-sm);
      font-size: var(--text-xs);
    }
  }
</style>
