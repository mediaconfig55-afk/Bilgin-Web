---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { kindLabel, statusLabel } from "../lib/format";
import { url } from "../lib/url";

interface Props {
  entries: CollectionEntry<"work">[];
}

const { entries } = Astro.props;

// Her projenin kapağı var; yoksa ilk ekran görüntüsü kullanılıyor.
// Dikey (telefon) görseller kırpılmadan, tam hâliyle gösteriliyor.
const cards = entries.map((entry) => {
  const cover = entry.data.cover;
  const fallback = entry.data.shots[0];
  return {
    entry,
    shot: cover ?? fallback?.src,
    alt: (cover ? entry.data.coverAlt : fallback?.alt) ?? `${entry.data.title} ekranı`,
    dikey: cover ? entry.data.coverFrame === "phone" : fallback?.frame === "phone",
  };
});
---

<ul class="cards" role="list">
  {
    cards.map(({ entry, shot, alt, dikey }, i) => (
      <li>
        <a class="card" href={url(`/isler/${entry.id}/`)}>
          <span class:list={["card__shot", { "card__shot--dikey": dikey }]}>
            {shot && (
              <Image
                src={shot}
                alt={alt}
                widths={[520, 1040]}
                sizes="(min-width: 46rem) 32rem, calc(100vw - 2.5rem)"
                loading={i < 2 ? "eager" : "lazy"}
              />
            )}
          </span>
          <span class="card__text">
            <span class="card__meta">
              {kindLabel[entry.data.kind]}
              <span class:list={["status", `status--${entry.data.status}`]}>
                {statusLabel[entry.data.status]}
              </span>
            </span>
            <span class="card__name">{entry.data.title}</span>
            <span class="card__what">{entry.data.tagline}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .cards {
    display: grid;
    gap: var(--space-xl);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .cards > li {
    display: grid;
  }

  .card {
    display: grid;
    gap: var(--space-md);
    align-content: start;
    height: 100%;
    text-decoration: none;
  }

  .card__shot {
    display: block;
    overflow: hidden;
    /* Bütün kartlar aynı oran: satırlar eşit yükseklikte hizalansın. */
    aspect-ratio: 4 / 3;
    border: var(--rule-hair) solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-paper-3);
  }

  .card__shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  /* Telefon ekranı: kırpma yok, tamamı ortada dursun.
     Kare kutu, yan yana duran yatay kartlarla aynı ritmi kırıyor. */
  .card__shot--dikey {
    display: grid;
    /* minmax(0, 1fr): satır kesin yükseklik alsın ki görselin height:100%'ü çözülebilsin. */
    grid-template-rows: minmax(0, 1fr);
    justify-items: center;
    padding: var(--space-lg);
    background: var(--color-paper-3);
  }

  .card__shot--dikey :global(img) {
    width: auto;
    max-width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: var(--radius-md);
    box-shadow: 0 1px 4px var(--color-shadow);
  }

  .card:hover .card__shot {
    border-color: var(--color-accent);
  }

  .card__text {
    display: grid;
    gap: var(--space-3xs);
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-xs) var(--space-md);
    font-size: var(--text-xs);
    color: var(--color-neutral);
  }

  .card__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    color: var(--color-ink);
  }

  .card:hover .card__name {
    color: var(--color-accent);
  }

  .card__what {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-muted);
    max-width: 46ch;
  }

  @media (min-width: 46rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2xl) var(--space-xl);
    }
  }
</style>
