---
import type { CollectionEntry } from "astro:content";
import { statusLabel } from "../lib/format";
import { url } from "../lib/url";

interface Props {
  entries: CollectionEntry<"work">[];
  caption?: string;
}

const { entries, caption = "İşlerin listesi" } = Astro.props;
const kindShort = { android: "Android", web: "Web" } as const;
---

<table class="work-table">
  <caption class="visually-hidden">{caption}</caption>
  <thead>
    <tr>
      <th scope="col">Proje</th>
      <th scope="col">Ne</th>
      <th scope="col">Tür</th>
      <th scope="col">Teknoloji</th>
      <th scope="col">Durum</th>
    </tr>
  </thead>
  <tbody>
    {
      entries.map((entry) => (
        <tr>
          <th scope="row">
            <a href={url(`/isler/${entry.id}/`)}>{entry.data.title}</a>
          </th>
          <td class="work-table__what">{entry.data.short}</td>
          <td class="work-table__kind">{kindShort[entry.data.kind]}</td>
          <td class="work-table__stack">{entry.data.stack.slice(0, 2).join(", ")}</td>
          <td class="work-table__status">
            <span class:list={["status", `status--${entry.data.status}`]}>
              {statusLabel[entry.data.status]}
            </span>
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .work-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  thead th {
    padding: 0 var(--space-md) var(--space-xs) 0;
    text-align: left;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-neutral);
    border-bottom: var(--rule-hair) solid var(--color-ink);
  }

  tbody th,
  tbody td {
    padding: var(--space-sm) var(--space-md) var(--space-sm) 0;
    text-align: left;
    vertical-align: baseline;
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  tbody th {
    font-weight: 400;
  }

  tbody th a {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  tbody th a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
  }

  tbody tr:hover {
    background: color-mix(in oklch, var(--color-paper-2) 60%, transparent);
  }

  .work-table__what {
    color: var(--color-muted);
  }

  .work-table__kind,
  .work-table__stack {
    color: var(--color-neutral);
  }

  @media (max-width: 47.99rem) {
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    tbody tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: var(--space-md);
      padding-block: var(--space-sm);
      border-bottom: var(--rule-hair) solid var(--color-rule);
    }

    tbody th,
    tbody td {
      padding: 0;
      border: 0;
    }

    .work-table__what {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .work-table__kind,
    .work-table__stack {
      display: none;
    }

    .work-table__status {
      grid-column: 2;
      grid-row: 1;
      font-size: var(--text-xs);
    }
  }
</style>
