---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { kindLabel, statusLabel } from "../lib/format";
import { url } from "../lib/url";

interface Props {
  entry: CollectionEntry<"work">;
}

const { entry } = Astro.props;
const { data } = entry;
const href = url(`/isler/${entry.id}/`);
const thumb = data.cover ?? data.icon;
const isIconOnly = !data.cover && Boolean(data.icon);
---

<article class="teaser">
  <a class:list={["teaser__thumb", { "teaser__thumb--icon": isIconOnly }]} href={href} tabindex="-1" aria-hidden="true">
    {
      thumb && (
        <Image
          src={thumb}
          alt=""
          widths={isIconOnly ? [96, 192] : [320, 640]}
          sizes={isIconOnly ? "4rem" : "(min-width: 48rem) 11rem, 34vw"}
          loading="lazy"
          decoding="async"
        />
      )
    }
  </a>
  <div class="teaser__body">
    <h3 class="teaser__title"><a href={href}>{data.title}</a></h3>
    <p class="teaser__line">{data.tagline}</p>
    <p class="teaser__meta">
      {kindLabel[data.kind]} · {data.stack.slice(0, 2).join(", ")} · {statusLabel[data.status]}
    </p>
  </div>
</article>

<style>
  .teaser {
    display: grid;
    grid-template-columns: minmax(0, 34%) minmax(0, 1fr);
    gap: var(--space-md) var(--space-lg);
    align-items: start;
    padding-block: var(--space-lg);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .teaser__thumb {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-md);
    background: var(--color-screen);
  }

  .teaser__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform var(--dur-long) var(--ease-out);
  }

  .teaser:hover .teaser__thumb :global(img) {
    transform: scale(1.02);
  }

  .teaser__thumb--icon {
    display: grid;
    place-items: center;
    background: var(--color-paper-3);
  }

  .teaser__thumb--icon :global(img) {
    width: 4rem;
    height: 4rem;
    border-radius: 0.9rem;
    object-fit: cover;
  }

  .teaser__title {
    font-size: var(--text-lg);
  }

  .teaser__title a {
    text-decoration: none;
  }

  .teaser__title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
  }

  .teaser__line {
    margin-top: var(--space-2xs);
    color: var(--color-muted);
  }

  .teaser__meta {
    margin-top: var(--space-xs);
    font-size: var(--text-xs);
    color: var(--color-neutral);
  }

  @media (min-width: 48rem) {
    .teaser {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }
</style>
