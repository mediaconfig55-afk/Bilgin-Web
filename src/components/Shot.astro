---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  frame?: "phone" | "desktop" | "wide";
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const {
  src,
  alt,
  caption,
  frame = "desktop",
  sizes,
  eager = false,
  class: className,
} = Astro.props;

const widths =
  frame === "phone" ? [280, 420, 560, 840].filter((w) => w <= src.width) : [640, 960, 1280, 1920, 2400].filter((w) => w <= src.width);

const defaultSizes =
  frame === "phone"
    ? "(min-width: 48rem) 17rem, 44vw"
    : "(min-width: 80rem) 76rem, calc(100vw - 2rem)";
---

<figure class:list={["shot", `shot--${frame}`, className]}>
  <div class="shot__media">
    <Picture
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes ?? defaultSizes}
      formats={["avif"]}
      fallbackFormat="webp"
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      decoding="async"
    />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot {
    margin: 0;
    min-width: 0;
  }

  .shot__media {
    overflow: hidden;
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-md);
    background: var(--color-paper-2);
  }

  .shot__media :global(img) {
    width: 100%;
    height: auto;
  }

  .shot--phone {
    max-width: 17rem;
  }

  .shot--phone .shot__media {
    border-radius: var(--radius-screen);
    border-color: var(--color-rule-strong);
    background: var(--color-screen);
  }

  figcaption {
    margin-top: var(--space-xs);
    font-size: var(--text-xs);
    color: var(--color-neutral);
  }
</style>
