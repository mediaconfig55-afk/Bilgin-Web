---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { site } from "../data/site";
import { sortWork } from "../lib/format";
import { url } from "../lib/url";

const work = (await getCollection("work")).sort(sortWork);
const apps = work.filter((entry) => entry.data.kind === "android" && entry.data.status === "live");
const sites = work.filter((entry) => entry.data.kind === "web" && entry.data.status === "live");
---

<section class="live" aria-labelledby="live-title">
  <h2 id="live-title" class="live__title">Şu an yayında</h2>

  <p class="live__group">
    Google Play
    <span>
      · geliştirici hesabı <a href={site.playDeveloper.url}>{site.playDeveloper.name}</a>
    </span>
  </p>
  <ul class="live__list" role="list">
    {
      apps.map((app) => (
        <li class="live__row">
          {app.data.icon ? (
            <Image
              class="live__icon"
              src={app.data.icon}
              alt=""
              width={44}
              height={44}
              densities={[1, 2]}
              loading="eager"
            />
          ) : (
            <span class="live__icon" aria-hidden="true" />
          )}
          <span class="live__text">
            <a class="live__name" href={url(`/isler/${app.id}/`)}>
              {app.data.title}
            </a>
            <span class="live__desc">{app.data.short}</span>
          </span>
          {app.data.version && <span class="live__ver tnum">{app.data.version}</span>}
          {app.data.playUrl && (
            <a class="live__ext" href={app.data.playUrl} aria-label={`${app.data.title}, Google Play’de`}>
              Play <span aria-hidden="true">↗</span>
            </a>
          )}
        </li>
      ))
    }
  </ul>

  <p class="live__group">Web</p>
  <ul class="live__list" role="list">
    {
      sites.map((entry) => (
        <li class="live__row live__row--web">
          <span class="live__text">
            <a class="live__name" href={url(`/isler/${entry.id}/`)}>
              {entry.data.title}
            </a>
            <span class="live__desc">
              {[entry.data.short, entry.data.location].filter(Boolean).join(", ")}
            </span>
          </span>
          {entry.data.liveUrl && (
            <a class="live__ext" href={entry.data.liveUrl} aria-label={`${entry.data.title} sitesini aç`}>
              Site <span aria-hidden="true">↗</span>
            </a>
          )}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .live {
    padding-top: var(--space-md);
    border-top: var(--rule-bold) solid var(--color-ink);
  }

  .live__title {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
  }

  .live__group {
    margin-top: var(--space-lg);
    padding-bottom: var(--space-xs);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-muted);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .live__group span {
    font-weight: 400;
    color: var(--color-neutral);
  }

  .live__group a {
    color: inherit;
  }

  .live__list {
    padding: 0;
    list-style: none;
  }

  .live__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-sm);
    padding-block: var(--space-sm);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .live__row--web {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .live__icon {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.7rem;
    background: var(--color-paper-3);
    object-fit: cover;
  }

  .live__text {
    display: grid;
    min-width: 0;
    line-height: 1.3;
  }

  .live__name {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 500;
    text-decoration: none;
  }

  .live__name:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
  }

  .live__desc {
    font-size: var(--text-xs);
    color: var(--color-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .live__ver {
    font-size: var(--text-xs);
    color: var(--color-neutral);
  }

  .live__ext {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-2xs);
    font-size: var(--text-xs);
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
  }

  .live__ext:hover {
    text-decoration: underline;
  }
</style>
