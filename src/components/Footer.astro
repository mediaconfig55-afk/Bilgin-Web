---
// Ft4 — künye. Sıkı bir bilgi bloğu; dört sütunluk bağlantı çiftliği yok.
import { site, whatsappUrl } from "../data/site";
import { url } from "../lib/url";
---

<footer class="foot">
  <div class="wrap">
    <div class="foot__top">
      <p class="foot__say">Aklındaki işi konuşalım.</p>
      <a class="btn" href={whatsappUrl()}>
        WhatsApp’tan yaz <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <dl class="colophon">
      <div>
        <dt>Telefon</dt>
        <dd><a class="tnum" href={`tel:${site.phone}`}>{site.phoneDisplay}</a></dd>
      </div>
      <div>
        <dt>E-posta</dt>
        <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
      </div>
      <div>
        <dt>Konum</dt>
        <dd>{site.city}, {site.country}</dd>
      </div>
      <div>
        <dt>Google Play</dt>
        <dd><a href={site.playDeveloper.url}>{site.playDeveloper.name}</a></dd>
      </div>
    </dl>

    <p class="foot__meta">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <a href={url("/isler/")}>İşler</a>
      <a href={url("/iletisim/")}>İletişim</a>
      <a href={url("/gizlilik/")}>Gizlilik</a>
    </p>
  </div>
</footer>

<style>
  .foot {
    border-top: var(--rule-hair) solid var(--color-line);
    background: var(--color-paper-2);
    padding-block: var(--space-2xl) var(--space-lg);
  }

  .foot__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-bottom: var(--space-xl);
  }

  .foot__say {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-xl);
    line-height: 1.2;
    letter-spacing: var(--tracking-heading);
  }

  .colophon {
    display: grid;
    gap: var(--space-lg) var(--space-xl);
    padding-block: var(--space-lg);
    border-top: var(--rule-hair) solid var(--color-line);
  }

  .colophon dt {
    font-size: var(--text-xs);
    color: var(--color-neutral);
  }

  .colophon dd {
    margin: var(--space-3xs) 0 0;
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }

  .colophon a {
    text-decoration: none;
  }

  .colophon a:hover {
    text-decoration: underline;
  }

  .foot__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    padding-top: var(--space-md);
    border-top: var(--rule-hair) solid var(--color-line);
    font-size: var(--text-xs);
    color: var(--color-neutral);
  }

  .foot__meta a {
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  .foot__meta a:hover {
    color: var(--color-accent);
  }

  @media (min-width: 40rem) {
    .colophon {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
