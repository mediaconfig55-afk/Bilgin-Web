---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import WorkCards from "../components/WorkCards.astro";
import { site, whatsappUrl } from "../data/site";
import { sortWork } from "../lib/format";
import { businessNode, graph, personNode, webPageNode, websiteNode } from "../lib/schema";
import { url } from "../lib/url";

const work = (await getCollection("work")).sort(sortWork);
const apps = work.filter((e) => e.data.kind === "android");
const sites = work.filter((e) => e.data.kind === "web");
const liveApps = apps.filter((e) => e.data.status === "live").length;

const hizmetler = [
  {
    ad: "Web sitesi tasarımı",
    ozet:
      "İşletmen için kurumsal site, ürün kataloğu ya da tanıtım sayfası. Telefonda hızlı açılır, Google’da bulunur, ziyaretçiyi tek dokunuşla sana getirir.",
    kapsam: [
      "Tasarım ve kodlama, hazır tema kullanmıyorum",
      "Her hizmet için ayrı sayfa, aramada görünsün diye",
      "Alan adı ve barındırma kurulumu",
      "Sonradan kolay güncellenen yapı",
    ],
    sayi: `${sites.length} proje`,
  },
  {
    ad: "Android uygulaması",
    ozet:
      "Fikrini telefonda çalışan bir uygulamaya çeviriyorum. Ekran tasarımından Google Play’e yüklemeye ve sonraki güncellemelere kadar işin tamamı bende.",
    kapsam: [
      "Ekran tasarımı ve kullanım akışı",
      "Bildirim, internetsiz çalışma, ödeme",
      "Google Play’e yükleme ve mağaza metinleri",
      "Yayından sonra hata düzeltme ve güncelleme",
    ],
    sayi: `Google Play’de ${liveApps} uygulama`,
  },
];

const adimlar = [
  {
    ad: "Anlatıyorsun",
    metin:
      "WhatsApp’tan birkaç cümle yazman yeterli. Ne istediğini, kimin kullanacağını ve elindeki malzemeyi konuşuyoruz.",
  },
  {
    ad: "Teklifi görüyorsun",
    metin:
      "Ne yapılacağını madde madde yazıya döküyorum. Fiyat ve teslim tarihi bu listeye göre çıkıyor; sonradan eklenen iş ayrıca konuşuluyor.",
  },
  {
    ad: "İlerlemeyi izliyorsun",
    metin:
      "İlk ekranlar hazır olunca görüyorsun. Uygulamayı bitmeden telefonuna kuruyorum, siteyi bir önizleme adresinden açıyorsun.",
  },
  {
    ad: "Yayına alıyorum",
    metin:
      "Google Play’e yükleme ya da siteyi alan adına bağlama bende. Yayından sonra çıkan hataları düzeltiyorum.",
  },
];

const fiyat = [
  {
    baslik: "Kaç ekran, kaç sayfa",
    metin: "En belirleyici şey bu. Beş sayfalık tanıtım sitesiyle yirmi sayfalık katalog aynı iş değil.",
  },
  {
    baslik: "Üyelik var mı",
    metin: "Kullanıcılar hesap açıp giriş yapacaksa arkada bir sistem kurulması gerekiyor.",
  },
  {
    baslik: "Ödeme alınacak mı",
    metin: "Uygulama içi satın alma ya da site üzerinden tahsilat işin süresini uzatıyor.",
  },
  {
    baslik: "İçerik hazır mı",
    metin: "Yazılar ve fotoğraflar sende hazırsa hızlı ilerliyoruz; değilse onu da birlikte çıkarıyoruz.",
  },
];

const title = "Emre Bilgin — Web Sitesi Tasarımı ve Android Uygulaması, Samsun";
const description =
  "Samsun’da web sitesi tasarımı ve Android uygulaması geliştiriyorum. Google Play’de yayında dört uygulama, işletmeler için hazırladığım siteler.";

const schema = graph(
  websiteNode(),
  personNode(),
  businessNode(),
  webPageNode({ path: "/", title, description }),
);
---

<Base title={title} description={description} schema={schema}>
  <section class="hero">
    <div class="wrap">
      <p class="hero__who">{site.name} · {site.city}</p>
      <h1 class="hero__title">Web sitesi tasarımı ve Android uygulaması yapıyorum.</h1>
      <p class="hero__lede">
        İşletmeler ve girişimler için. İşi alan, tasarlayan, kodlayan ve yayına çıkaran aynı kişi —
        aracı yok.
      </p>
      <div class="hero__act">
        <a class="btn" href={whatsappUrl()}>
          WhatsApp’tan yaz <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="link-more" href={url("/isler/")}>
          İşleri gör <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--line" aria-labelledby="ne-basligi">
    <div class="wrap">
      <p class="block-label">Ne yapıyorum</p>
      <h2 id="ne-basligi" class="section-title">İki iş yapıyorum, ikisini de baştan sona</h2>

      <div class="hizmetler">
        {
          hizmetler.map((h) => (
            <article class="hizmet">
              <h3 class="hizmet__ad">{h.ad}</h3>
              <p class="hizmet__sayi">{h.sayi}</p>
              <p class="hizmet__ozet">{h.ozet}</p>
              <ul class="hizmet__kapsam" role="list">
                {h.kapsam.map((k) => (
                  <li>{k}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--fill" aria-labelledby="nasil-basligi">
    <div class="wrap">
      <p class="block-label">Nasıl ilerliyor</p>
      <h2 id="nasil-basligi" class="section-title">Dört adım, sürpriz yok</h2>

      <ol class="adimlar" role="list">
        {
          adimlar.map((a, i) => (
            <li class="adim">
              <span class="adim__no tnum" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class="adim__ad">{a.ad}</h3>
              <p class="adim__metin">{a.metin}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="fiyat-basligi">
    <div class="wrap">
      <p class="block-label">Fiyatı ne belirliyor</p>
      <h2 id="fiyat-basligi" class="section-title">Hazır fiyat listesi vermiyorum</h2>
      <p class="section-lede">
        Çünkü aynı fiyata iki farklı iş çıkmaz. Kısa bir görüşmeden sonra kalem kalem yazılı teklif
        hazırlıyorum; neyin maliyeti artırdığını görerek karar veriyorsun. Fiyatı en çok şunlar
        belirliyor:
      </p>

      <dl class="fiyat">
        {
          fiyat.map((f) => (
            <div class="fiyat__satir">
              <dt>{f.baslik}</dt>
              <dd>{f.metin}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section section--line" aria-labelledby="isler-basligi">
    <div class="wrap">
      <div class="isler__head">
        <div>
          <p class="block-label">İşler</p>
          <h2 id="isler-basligi" class="section-title">Yaptıklarımdan birkaçı</h2>
        </div>
        <a class="link-more" href={url("/isler/")}>
          Bütün işler <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <WorkCards entries={work.slice(0, 4)} />
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(3.5rem, 2.5rem + 5vw, 7rem) var(--section-gap);
  }

  .hero__who {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-neutral);
  }

  .hero__title {
    margin-top: var(--space-md);
    font-size: var(--text-display);
    font-weight: 700;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    max-width: 18ch;
  }

  .hero__lede {
    margin-top: var(--space-lg);
    font-size: var(--text-md);
    line-height: 1.5;
    color: var(--color-muted);
    max-width: 48ch;
  }

  .hero__act {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-xl);
    margin-top: var(--space-xl);
  }

  /* Ne yapıyorum */
  .hizmetler {
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-2xl);
  }

  .hizmet {
    padding-top: var(--space-md);
    border-top: var(--rule-bold) solid var(--color-ink);
  }

  .hizmet__ad {
    font-size: var(--text-xl);
  }

  .hizmet__sayi {
    margin-top: var(--space-2xs);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
  }

  .hizmet__ozet {
    margin-top: var(--space-md);
    color: var(--color-muted);
    max-width: 46ch;
  }

  .hizmet__kapsam {
    display: grid;
    gap: var(--space-xs);
    margin-top: var(--space-lg);
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .hizmet__kapsam li {
    display: grid;
    grid-template-columns: 1.2rem minmax(0, 1fr);
    align-items: baseline;
  }

  .hizmet__kapsam li::before {
    content: "—";
    color: var(--color-accent);
  }

  /* Nasıl ilerliyor */
  .adimlar {
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-2xl);
    padding: 0;
    list-style: none;
  }

  .adim {
    padding-top: var(--space-md);
    border-top: var(--rule-hair) solid var(--color-line-strong);
  }

  .adim__no {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent);
  }

  .adim__ad {
    margin-top: var(--space-2xs);
    font-size: var(--text-lg);
  }

  .adim__metin {
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /* Fiyat */
  .fiyat {
    margin-top: var(--space-2xl);
    border-top: var(--rule-hair) solid var(--color-line);
  }

  .fiyat__satir {
    display: grid;
    gap: var(--space-2xs) var(--space-xl);
    padding-block: var(--space-lg);
    border-bottom: var(--rule-hair) solid var(--color-line);
  }

  .fiyat dt {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
  }

  .fiyat dd {
    margin: 0;
    color: var(--color-muted);
    max-width: 56ch;
  }

  /* İşler */
  .isler__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-md) var(--space-xl);
    margin-bottom: var(--space-2xl);
  }

  @media (min-width: 46rem) {
    .hizmetler {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2xl);
    }

    .adimlar {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .fiyat__satir {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      align-items: baseline;
    }
  }
</style>
