---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ContactBlock from "../components/ContactBlock.astro";
import { breadcrumbNode, graph, webPageNode } from "../lib/schema";
import { absoluteUrl, url } from "../lib/url";

const items = [
  {
    href: "/android-uygulama-gelistirme/",
    title: "Android uygulama geliştirme",
    text: "Ekran tasarımından Google Play yayınına ve sonraki güncellemelere kadar. React Native (Expo) ya da Kotlin; gerekiyorsa Firebase veya Supabase ile arka uç.",
    note: "Google Play’de yayında 4 uygulama",
  },
  {
    href: "/web-sitesi-tasarimi/",
    title: "Web sitesi tasarımı",
    text: "Kurumsal site, ürün kataloğu, içerik sitesi ya da tanıtım sayfası. Hazır tema yok; telefonda hızlı açılan, aramada bulunan, ziyaretçiyi sana yönlendiren sayfalar.",
    note: "Teknik SEO ve Search Console kurulumu dahil",
  },
  {
    href: "/yapay-zeka-destekli-gelistirme/",
    title: "Yapay zeka destekli geliştirme",
    text: "Yapay zeka araçlarıyla hızlanan ama her sürümü elle denetlenen bir çalışma şekli. İstersen uygulamanın içine de yapay zeka özellikleri ekleniyor.",
    note: "Neyin hızlandığı, neyin elle yapıldığı açık",
  },
  {
    href: "/samsun-web-tasarim/",
    title: "Samsun’da web tasarım ve uygulama",
    text: "Samsun’daki işletmeler için yüz yüze görüşme ve şehir, ilçe aramalarına göre kurulan sayfalar.",
    note: "Samsun’dan yayında bir site ve bir uygulama",
  },
];

const title = "Hizmetler: Android Uygulama, Web Sitesi ve Yapay Zeka | Emre Bilgin";
const description =
  "Android uygulama geliştirme, web sitesi tasarımı ve yapay zeka destekli geliştirme. Samsun’da yüz yüze, Türkiye geneli uzaktan çalışan tek kişilik bir stüdyo.";
const crumbs = [
  { name: "Ana sayfa", href: "/" },
  { name: "Hizmetler", href: "/hizmetler/" },
];

const schema = graph(
  webPageNode({ path: "/hizmetler/", title, description, type: "CollectionPage", crumbs }),
  breadcrumbNode("/hizmetler/", crumbs),
  {
    "@type": "ItemList",
    "@id": `${absoluteUrl("/hizmetler/")}#liste`,
    itemListElement: items.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: absoluteUrl(item.href),
      name: item.title,
    })),
  },
);
---

<Base title={title} description={description} schema={schema} og="hizmetler">
  <div class="wrap page-head">
    <Breadcrumbs items={crumbs} />
    <h1 class="page-title">Hizmetler</h1>
    <p class="lede">
      Tek kişilik bir stüdyoyum: işi alan, tasarlayan, yazan ve yayına çıkaran aynı kişi. Dört başlık
      altında çalışıyorum.
    </p>
  </div>

  <div class="wrap">
    <ol class="services" role="list">
      {
        items.map((item) => (
          <li class="services__item">
            <h2 class="services__title">
              <a href={url(item.href)}>{item.title}</a>
            </h2>
            <p class="services__text">{item.text}</p>
            <p class="services__note">{item.note}</p>
            <a class="link-more services__more" href={url(item.href)} aria-hidden="true" tabindex="-1">
              Ayrıntılar <span class="arrow">→</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>

  <ContactBlock />
</Base>

<style>
  .services {
    padding: 0;
    list-style: none;
    border-top: var(--rule-bold) solid var(--color-ink);
  }

  .services__item {
    display: grid;
    gap: var(--space-sm) var(--space-3xl);
    padding-block: var(--space-xl);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .services__title {
    font-size: var(--text-2xl);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .services__title a {
    text-decoration: none;
  }

  .services__title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
  }

  .services__text {
    color: var(--color-muted);
    max-width: 58ch;
  }

  .services__note {
    font-size: var(--text-sm);
    color: var(--color-neutral);
  }

  .services__more {
    justify-self: start;
  }

  @media (min-width: 60rem) {
    .services__item {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      align-items: start;
    }

    .services__title {
      grid-row: span 3;
    }
  }
</style>
