---
import Base from "../layouts/Base.astro";
import { site, whatsappUrl } from "../data/site";
import { breadcrumbNode, graph, personNode, webPageNode } from "../lib/schema";
import { absoluteUrl } from "../lib/url";

const title = "İletişim — Emre Bilgin, Samsun";
const description =
  "Android uygulaması ya da web sitesi için WhatsApp, telefon veya e-posta. Samsun’da yüz yüze, Türkiye geneli uzaktan.";
const crumbs = [
  { name: "Ana sayfa", href: "/" },
  { name: "İletişim", href: "/iletisim/" },
];

const kanallar = [
  {
    label: "WhatsApp",
    value: site.phoneDisplay,
    href: whatsappUrl(),
    note: "En hızlısı. Yazılı ya da sesli mesaj at.",
    primary: true,
  },
  {
    label: "Telefon",
    value: site.phoneDisplay,
    href: `tel:${site.phone}`,
    note: "Açamazsam geri dönüyorum.",
  },
  {
    label: "E-posta",
    value: site.email,
    href: `mailto:${site.email}`,
    note: "Uzun anlatım ve dosya için.",
  },
];

const schema = graph(
  {
    ...webPageNode({ path: "/iletisim/", title, description, type: "ContactPage", crumbs }),
    about: { "@id": absoluteUrl("/#hizmet") },
  },
  personNode(),
  breadcrumbNode("/iletisim/", crumbs),
);
---

<Base title={title} description={description} schema={schema} og="iletisim">
  <div class="wrap page-head">
    <p class="block-label">İletişim</p>
    <h1 class="page-title">Fikrini anlat, gerisini ben çıkarayım</h1>
    <p class="lede">
      Ne yapmak istediğini iki üç cümleyle yaz. Ne kadar süreceğini ve ne tutacağını yazılı
      göndereyim.
    </p>
  </div>

  <div class="wrap page">
    <ul class="kanallar" role="list">
      {
        kanallar.map((k) => (
          <li class:list={["kanal", { "kanal--primary": k.primary }]}>
            <p class="kanal__label">{k.label}</p>
            <a class:list={["kanal__value", { tnum: k.label !== "E-posta" }]} href={k.href}>
              {k.value}
            </a>
            <p class="kanal__note">{k.note}</p>
          </li>
        ))
      }
      <li class="kanal">
        <p class="kanal__label">Nerede</p>
        <p class="kanal__value">Samsun</p>
        <p class="kanal__note">Buradaysan yüz yüze; değilsen uzaktan çalışıyoruz.</p>
      </li>
    </ul>

    <section class="brief" aria-labelledby="brief-basligi">
      <h2 id="brief-basligi" class="brief__title">Mesajda şunlar olsun</h2>
      <ol class="brief__list">
        <li><strong>Ne istiyorsun.</strong> “Müşterilerim telefondan randevu alsın” yeter.</li>
        <li><strong>Kim kullanacak.</strong> Müşterilerin mi, çalışanların mı?</li>
        <li><strong>Beğendiğin bir örnek.</strong> Varsa bağlantısı çok iş görür.</li>
        <li><strong>Tarih.</strong> Yetişmesi gereken bir gün varsa.</li>
      </ol>
      <p class="brief__note">
        Bütçen belliyse yaz, kapsamı ona göre önereyim. Belli değilse de sorun yok.
      </p>
      <a class="btn" href={whatsappUrl()}>
        WhatsApp’tan yaz <span class="arrow" aria-hidden="true">→</span>
      </a>
    </section>
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: var(--space-2xl);
    padding-bottom: var(--section-gap);
  }

  .kanallar {
    display: grid;
    gap: var(--space-md);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .kanal {
    padding: var(--space-md) var(--space-lg);
    border: var(--rule-hair) solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-paper-2);
  }

  .kanal--primary {
    border-color: var(--color-accent);
    background: var(--color-accent-wash);
  }

  .kanal__label {
    font-size: var(--text-xs);
    color: var(--color-neutral);
  }

  .kanal__value {
    display: block;
    margin-top: var(--space-3xs);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: var(--tracking-heading);
    color: var(--color-ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  a.kanal__value:hover {
    color: var(--color-accent);
  }

  .kanal__note {
    margin-top: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .brief {
    align-self: start;
    padding-top: var(--space-md);
    border-top: var(--rule-bold) solid var(--color-line-strong);
  }

  .brief__title {
    font-size: var(--text-xl);
  }

  .brief__list {
    display: grid;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
    padding-left: 1.2em;
    color: var(--color-muted);
  }

  .brief__list li::marker {
    color: var(--color-accent);
  }

  .brief__list strong {
    color: var(--color-ink);
  }

  .brief__note {
    margin-block: var(--space-lg);
    font-size: var(--text-sm);
    color: var(--color-muted);
    max-width: 44ch;
  }

  @media (min-width: 60rem) {
    .page {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      column-gap: var(--space-3xl);
    }

    .kanallar {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
