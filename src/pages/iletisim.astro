---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { site, whatsappUrl } from "../data/site";
import { breadcrumbNode, graph, personNode, webPageNode } from "../lib/schema";
import { absoluteUrl, url } from "../lib/url";

const briefBody = [
  "Merhaba Emre,",
  "",
  "Ne yapmak istiyorum:",
  "Kimler kullanacak:",
  "Beğendiğim örnekler:",
  "Aklımdaki tarih:",
  "",
].join("\n");
const briefMailto = `mailto:${site.email}?subject=${encodeURIComponent("Proje özeti")}&body=${encodeURIComponent(briefBody)}`;

const title = "İletişim | Emre Bilgin, Samsun";
const description =
  "Android uygulama ya da web sitesi için Emre Bilgin’e WhatsApp, telefon veya e-postayla ulaş. Samsun’da yüz yüze, Türkiye geneli uzaktan görüşme.";
const crumbs = [
  { name: "Ana sayfa", href: "/" },
  { name: "İletişim", href: "/iletisim/" },
];

const schema = graph(
  {
    ...webPageNode({ path: "/iletisim/", title, description, type: "ContactPage", crumbs }),
    about: { "@id": absoluteUrl("/#hizmet") },
  },
  personNode(),
  breadcrumbNode("/iletisim/", crumbs),
);
---

<Base title={title} description={description} schema={schema} og="iletisim">
  <div class="wrap page-head">
    <Breadcrumbs items={crumbs} />
    <h1 class="page-title">İletişim</h1>
    <p class="lede">
      En hızlı yol WhatsApp. Kısa bir mesaj yeterli; gerisini birlikte netleştiririz.
    </p>
  </div>

  <div class="wrap contact-page">
    <ul class="channels" role="list">
      <li class="channel">
        <p class="channel__label">WhatsApp</p>
        <a class="channel__value tnum" href={whatsappUrl()}>{site.phoneDisplay}</a>
        <p class="channel__note">Yazılı mesaj, sesli mesaj ya da görsel gönderebilirsin.</p>
      </li>
      <li class="channel">
        <p class="channel__label">Telefon</p>
        <a class="channel__value tnum" href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
        <p class="channel__note">Açamazsam mesajını görüp geri dönüyorum.</p>
      </li>
      <li class="channel">
        <p class="channel__label">E-posta</p>
        <a class="channel__value" href={`mailto:${site.email}`}>{site.email}</a>
        <p class="channel__note">
          Uzun anlatımlar ve dosyalar için. <a href={briefMailto}>Hazır bir proje özeti şablonuyla yaz.</a>
        </p>
      </li>
      <li class="channel">
        <p class="channel__label">Konum</p>
        <p class="channel__value">Samsun, Türkiye</p>
        <p class="channel__note">
          Samsun’da yüz yüze görüşebiliriz. <a href={url("/samsun-web-tasarim/")}>Samsun’daki işletmeler için</a>
        </p>
      </li>
    </ul>

    <section class="brief" aria-labelledby="brief-title">
      <h2 id="brief-title" class="brief__title">Mesajında ne olsun?</h2>
      <ol class="brief__list">
        <li>
          <strong>Ne yapmak istediğin.</strong> İki üç cümle yeterli: “Müşterilerim telefondan randevu
          alabilsin” gibi.
        </li>
        <li><strong>Kimlerin kullanacağı.</strong> Müşterilerin mi, çalışanların mı, herkes mi?</li>
        <li>
          <strong>Beğendiğin örnekler.</strong> Benzer bir uygulama ya da site varsa bağlantısı çok iş görür.
        </li>
        <li><strong>Tarih.</strong> Bir açılış, sezon ya da etkinlik için yetişmesi gerekiyorsa.</li>
      </ol>
      <p class="brief__note">
        Bütçen belliyse onu da yazabilirsin; kapsamı ona göre önerebilirim. Belli değilse sorun değil,
        teklifte kalem kalem göreceksin.
      </p>
      <a class="btn" href={whatsappUrl()}>
        WhatsApp’tan yaz <span class="arrow" aria-hidden="true">→</span>
      </a>
    </section>
  </div>
</Base>

<style>
  .contact-page {
    display: grid;
    gap: var(--space-2xl);
    padding-bottom: var(--section-gap);
  }

  .channels {
    padding: 0;
    list-style: none;
    border-top: var(--rule-bold) solid var(--color-ink);
  }

  .channel {
    display: grid;
    gap: var(--space-2xs);
    padding-block: var(--space-lg);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .channel__label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-neutral);
  }

  .channel__value {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.2;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  a.channel__value:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
  }

  .channel__note {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .brief {
    align-self: start;
    padding-top: var(--space-md);
    border-top: var(--rule-hair) solid var(--color-ink);
  }

  .brief__title {
    font-size: var(--text-xl);
  }

  .brief__list {
    display: grid;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
    padding-left: 1.3em;
    color: var(--color-muted);
  }

  .brief__list strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  .brief__note {
    margin-block: var(--space-lg);
    color: var(--color-muted);
    max-width: 56ch;
  }

  @media (min-width: 64rem) {
    .contact-page {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      column-gap: var(--space-3xl);
    }
  }
</style>
