---
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { kindLabel, sortWork, statusLabel } from "../../lib/format";
import { breadcrumbNode, graph, webPageNode } from "../../lib/schema";
import { url } from "../../lib/url";
import { whatsappUrl } from "../../data/site";

export async function getStaticPaths() {
  const work = (await getCollection("work")).sort(sortWork);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}

interface Props {
  entry: CollectionEntry<"work">;
  next: CollectionEntry<"work">;
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const path = `/isler/${entry.id}/`;
const title = `${d.title} — ${d.short} | Emre Bilgin`;
const crumbs = [
  { name: "Ana sayfa", href: "/" },
  { name: "İşler", href: "/isler/" },
  { name: d.title, href: path },
];

// Kapak ve ekranlar tek bir galeride; dikey ekranlar yan yana, geniş olanlar tam satır.
const gallery = [
  ...(d.cover
    ? [{ src: d.cover, alt: d.coverAlt ?? d.title, caption: undefined as string | undefined, frame: d.coverFrame }]
    : []),
  ...d.shots.map((s) => ({ src: s.src, alt: s.alt, caption: s.caption, frame: s.frame })),
];

const kunye = [
  ["Ne", kindLabel[d.kind]],
  ["Alan", d.category],
  ["Durum", statusLabel[d.status]],
  ...(d.client ? [["Müşteri", d.client]] : []),
  ...(d.location ? [["Yer", d.location]] : []),
  ["Yıl", String(d.year)],
] as const;

const schema = graph(
  webPageNode({ path, title, description: d.description, crumbs }),
  breadcrumbNode(path, crumbs),
);
---

<Base title={title} description={d.description} schema={schema} og={entry.id} ogAlt={d.coverAlt}>
  <article>
    <div class="wrap page-head">
      <p class="block-label">{kindLabel[d.kind]}</p>
      <h1 class="page-title">{d.title}</h1>
      <p class="lede">{d.tagline}</p>

      <div class="basliklar">
        {
          d.playUrl && (
            <a class="btn" href={d.playUrl}>
              Google Play’de aç <span class="arrow" aria-hidden="true">↗</span>
            </a>
          )
        }
        {
          d.liveUrl && (
            <a class="btn btn--quiet" href={d.liveUrl}>
              Siteyi aç <span class="arrow" aria-hidden="true">↗</span>
            </a>
          )
        }
        {d.links.map((link) => <a class="link-more" href={link.href}>{link.label}</a>)}
      </div>
    </div>

    <div class="wrap">
      <dl class="kunye">
        {
          kunye.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    {
      gallery.length > 0 && (
        <div class="wrap galeri">
          {gallery.map((shot, i) => (
            <figure class:list={["cerceve", { "cerceve--genis": shot.frame !== "phone" }]}>
              <Image
                src={shot.src}
                alt={shot.alt}
                widths={[520, 1040]}
                sizes={
                  shot.frame === "phone"
                    ? "(min-width: 46rem) 22rem, calc(100vw - 2.5rem)"
                    : "(min-width: 46rem) 46rem, calc(100vw - 2.5rem)"
                }
                loading={i === 0 ? "eager" : "lazy"}
              />
              {shot.caption && <figcaption>{shot.caption}</figcaption>}
            </figure>
          ))}
        </div>
      )
    }

    <div class="wrap anlatim">
      <div class="prose"><Content /></div>
    </div>

    <nav class="wrap devam" aria-label="Sonraki iş">
      <a class="devam__link" href={url(`/isler/${next.id}/`)}>
        <span class="devam__etiket">Sıradaki iş</span>
        <span class="devam__ad">
          {next.data.title} <span class="arrow" aria-hidden="true">→</span>
        </span>
      </a>
      <a class="btn" href={whatsappUrl(`Merhaba Emre, ${d.title} projesini gördüm.`)}>
        Benzerini konuşalım <span class="arrow" aria-hidden="true">→</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .basliklar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
    margin-top: var(--space-xl);
  }

  .kunye {
    display: grid;
    gap: var(--space-md) var(--space-xl);
    padding-block: var(--space-lg);
    border-block: var(--rule-hair) solid var(--color-line);
  }

  .kunye dt {
    font-size: var(--text-xs);
    color: var(--color-neutral);
  }

  .kunye dd {
    margin: var(--space-3xs) 0 0;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .galeri {
    display: grid;
    gap: var(--space-lg);
    padding-block: var(--space-2xl);
  }

  .cerceve {
    margin: 0;
    overflow: hidden;
    border: var(--rule-hair) solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-paper-2);
  }

  .cerceve :global(img) {
    width: 100%;
    height: auto;
  }

  .cerceve figcaption {
    padding: var(--space-sm) var(--space-md);
    font-size: var(--text-xs);
    color: var(--color-neutral);
    border-top: var(--rule-hair) solid var(--color-line);
  }

  .anlatim {
    padding-bottom: var(--space-2xl);
  }

  .devam {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-block: var(--space-xl) var(--section-gap);
    border-top: var(--rule-hair) solid var(--color-line);
  }

  .devam__link {
    display: grid;
    gap: var(--space-3xs);
    text-decoration: none;
  }

  .devam__etiket {
    font-size: var(--text-xs);
    color: var(--color-neutral);
  }

  .devam__ad {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    color: var(--color-ink);
  }

  .devam__link:hover .devam__ad {
    color: var(--color-accent);
  }

  @media (min-width: 46rem) {
    .kunye {
      grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    }

    .galeri {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }

    /* Telefon ekranı olmayan görseller tam satır kaplıyor. */
    .cerceve--genis {
      grid-column: 1 / -1;
    }
  }
</style>
