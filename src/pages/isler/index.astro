---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import WorkCards from "../../components/WorkCards.astro";
import { sortWork } from "../../lib/format";
import { breadcrumbNode, graph, webPageNode } from "../../lib/schema";
import { absoluteUrl } from "../../lib/url";

const work = (await getCollection("work")).sort(sortWork);
const apps = work.filter((e) => e.data.kind === "android");
const sites = work.filter((e) => e.data.kind === "web");

const gruplar = [
  {
    id: "uygulamalar",
    etiket: "Android uygulaması",
    baslik: "Google Play’de yayında",
    entries: apps,
  },
  {
    id: "siteler",
    etiket: "Web sitesi",
    baslik: "İşletmeler için hazırladığım siteler",
    entries: sites,
  },
];

const title = "İşler — Web Siteleri ve Android Uygulamaları | Emre Bilgin";
const description =
  "Google Play’de yayında olan Android uygulamaları ve işletmeler için hazırladığım web siteleri. Ekran görüntüleri gerçek sürümlerden.";
const crumbs = [
  { name: "Ana sayfa", href: "/" },
  { name: "İşler", href: "/isler/" },
];

const schema = graph(
  webPageNode({ path: "/isler/", title, description, type: "CollectionPage", crumbs }),
  breadcrumbNode("/isler/", crumbs),
  {
    "@type": "ItemList",
    "@id": `${absoluteUrl("/isler/")}#liste`,
    itemListElement: work.map((entry, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: absoluteUrl(`/isler/${entry.id}/`),
      name: entry.data.title,
    })),
  },
);
---

<Base title={title} description={description} schema={schema} og="isler">
  <div class="wrap page-head">
    <p class="block-label">İşler</p>
    <h1 class="page-title">{apps.length} uygulama, {sites.length} web projesi</h1>
    <p class="lede">
      Her birinin sayfasında ne işe yaradığını ve ekranlarını görürsün. Görüntüler gerçek
      sürümlerden alındı.
    </p>
  </div>

  {
    gruplar.map((grup) => (
      <section class="section section--line" id={grup.id} aria-labelledby={`${grup.id}-basligi`}>
        <div class="wrap">
          <p class="block-label">{grup.etiket}</p>
          <h2 id={`${grup.id}-basligi`} class="section-title">
            {grup.baslik}
          </h2>
          <div class="grup__liste">
            <WorkCards entries={grup.entries} />
          </div>
        </div>
      </section>
    ))
  }
</Base>

<style>
  .grup__liste {
    margin-top: var(--space-2xl);
  }
</style>
