---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ContactBlock from "../../components/ContactBlock.astro";
import { formatDate, isoDate, readingMinutes, sortPosts } from "../../lib/format";
import { breadcrumbNode, graph, webPageNode } from "../../lib/schema";
import { absoluteUrl, url } from "../../lib/url";

const posts = (await getCollection("posts")).sort(sortPosts);

const title = "Yazılar: Android, Web ve Google Play Notları | Emre Bilgin";
const description =
  "Android uygulama yaptırma maliyetleri, Google Play yayın süreci ve yapay zekayla geliştirme üzerine, kendi projelerimden çıkan notlar.";
const crumbs = [
  { name: "Ana sayfa", href: "/" },
  { name: "Yazılar", href: "/yazilar/" },
];

const schema = graph(
  webPageNode({ path: "/yazilar/", title, description, type: "CollectionPage", crumbs }),
  breadcrumbNode("/yazilar/", crumbs),
  {
    "@type": "Blog",
    "@id": `${absoluteUrl("/yazilar/")}#blog`,
    name: "Emre Bilgin · Yazılar",
    url: absoluteUrl("/yazilar/"),
    inLanguage: "tr-TR",
    author: { "@id": absoluteUrl("/#emre-bilgin") },
    blogPost: posts.map((post) => ({ "@id": `${absoluteUrl(`/yazilar/${post.id}/`)}#yazi` })),
  },
);
---

<Base title={title} description={description} schema={schema} og="yazilar">
  <div class="wrap page-head">
    <Breadcrumbs items={crumbs} />
    <h1 class="page-title">Yazılar</h1>
    <p class="lede">
      Yaptığım işlerden çıkan notlar. Genel geçer tavsiye yerine kendi uygulamalarımda ve sitelerimde
      karşılaştığım şeyleri yazıyorum.
    </p>
  </div>

  <div class="wrap">
    <ol class="archive" role="list">
      {
        posts.map((post) => (
          <li class="archive__item">
            <p class="archive__meta">
              <time datetime={isoDate(post.data.published)}>{formatDate(post.data.published)}</time>
              <span> · {post.data.topic}</span>
              <span> · {readingMinutes(post.body ?? "")} dk okuma</span>
            </p>
            <h2 class="archive__title">
              <a href={url(`/yazilar/${post.id}/`)}>{post.data.title}</a>
            </h2>
            <p class="archive__desc">{post.data.description}</p>
          </li>
        ))
      }
    </ol>
  </div>

  <ContactBlock />
</Base>

<style>
  .archive {
    padding: 0;
    list-style: none;
    border-top: var(--rule-bold) solid var(--color-ink);
  }

  .archive__item {
    display: grid;
    gap: var(--space-xs);
    padding-block: var(--space-xl);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .archive__meta {
    font-size: var(--text-xs);
    color: var(--color-neutral);
  }

  .archive__title {
    font-size: var(--text-xl);
    max-width: 30ch;
  }

  .archive__title a {
    text-decoration: none;
  }

  .archive__title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
  }

  .archive__desc {
    color: var(--color-muted);
    max-width: 64ch;
  }
</style>
