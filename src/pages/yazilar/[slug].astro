---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ContactBlock from "../../components/ContactBlock.astro";
import WorkTeaser from "../../components/WorkTeaser.astro";
import { services } from "../../data/site";
import { formatDate, isoDate, readingMinutes, sortPosts } from "../../lib/format";
import { articleNode, breadcrumbNode, graph, personNode, webPageNode } from "../../lib/schema";
import { absoluteUrl, url } from "../../lib/url";

export async function getStaticPaths() {
  const posts = (await getCollection("posts")).sort(sortPosts);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, others: posts.filter((other) => other.id !== post.id).slice(0, 3) },
  }));
}

interface Props {
  post: CollectionEntry<"posts">;
  others: CollectionEntry<"posts">[];
}

const { post, others } = Astro.props;
const { data } = post;
const { Content } = await render(post);

const path = `/yazilar/${post.id}/`;
const og = `yazi-${post.id}`;
const title = `${data.seoTitle ?? data.title} | Emre Bilgin`;
const minutes = readingMinutes(post.body ?? "");
const crumbs = [
  { name: "Ana sayfa", href: "/" },
  { name: "Yazılar", href: "/yazilar/" },
  { name: data.title, href: path },
];

const work = await getCollection("work");
const relatedWork = data.relatedWork
  .map((slug) => work.find((entry) => entry.id === slug))
  .filter((entry): entry is NonNullable<typeof entry> => Boolean(entry));
const relatedService = services.find((service) => service.href === data.relatedService);

const ogImage = absoluteUrl(`/og/${og}.png`);
const schema = graph(
  webPageNode({ path, title, description: data.description, crumbs, image: ogImage }),
  breadcrumbNode(path, crumbs),
  articleNode({
    path,
    title: data.title,
    description: data.description,
    published: data.published,
    updated: data.updated,
    image: ogImage,
  }),
  personNode(),
);
---

<Base
  title={title}
  description={data.description}
  schema={schema}
  og={og}
  type="article"
  published={data.published}
  updated={data.updated}
>
  <article class="post">
    <header class="wrap post__head">
      <Breadcrumbs items={crumbs} />
      <p class="post__meta">
        <span>{data.topic}</span>
        <span aria-hidden="true"> · </span>
        <time datetime={isoDate(data.published)}>{formatDate(data.published)}</time>
        <span aria-hidden="true"> · </span>
        <span>{minutes} dk okuma</span>
      </p>
      <h1 class="post__title">{data.title}</h1>
      <p class="lede post__lede">{data.description}</p>
    </header>

    <div class="wrap">
      <div class="prose post__body">
        <Content />
      </div>

      <aside class="author" aria-label="Yazar">
        <p>
          <strong>Emre Bilgin.</strong> Samsun’da Android uygulamaları ve web siteleri geliştiriyor; Google
          Play’de dört uygulaması yayında.
          <a href={url("/hakkimda/")}>Hakkımda</a>
        </p>
        {
          data.updated && (
            <p class="author__updated">
              Son güncelleme: <time datetime={isoDate(data.updated)}>{formatDate(data.updated)}</time>
            </p>
          )
        }
      </aside>
    </div>
  </article>

  {
    relatedWork.length > 0 && (
      <section class="section section--rule" aria-labelledby="related-title">
        <div class="wrap">
          <h2 id="related-title" class="section-title post__section-title">
            Yazıda geçen işler
          </h2>
          <div class="related">
            {relatedWork.map((entry) => (
              <WorkTeaser entry={entry} />
            ))}
          </div>
          {relatedService && (
            <p class="post__service">
              İlgili hizmet: <a href={url(relatedService.href)}>{relatedService.title}</a>
            </p>
          )}
        </div>
      </section>
    )
  }

  {
    others.length > 0 && (
      <section class="section section--rule" aria-labelledby="others-title">
        <div class="wrap">
          <h2 id="others-title" class="section-title post__section-title">
            Diğer yazılar
          </h2>
          <ul class="others" role="list">
            {others.map((other) => (
              <li>
                <a href={url(`/yazilar/${other.id}/`)}>{other.data.title}</a>
                <span>{formatDate(other.data.published)}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <ContactBlock />
</Base>

<style>
  .post__head {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .post__meta {
    margin-top: var(--space-xl);
    font-size: var(--text-xs);
    color: var(--color-neutral);
  }

  .post__title {
    margin-top: var(--space-sm);
    font-size: var(--text-2xl);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    max-width: 24ch;
  }

  .post__lede {
    margin-top: var(--space-md);
  }

  .post__body {
    padding-top: var(--space-xl);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .post__body :global(h2:first-child) {
    margin-top: 0;
  }

  .author {
    max-width: var(--measure);
    margin-top: var(--space-2xl);
    padding-top: var(--space-md);
    border-top: var(--rule-hair) solid var(--color-ink);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .author strong {
    color: var(--color-ink);
  }

  .author__updated {
    margin-top: var(--space-xs);
    font-size: var(--text-xs);
  }

  .post__section-title {
    margin-bottom: var(--space-xl);
  }

  .related {
    display: grid;
    border-top: var(--rule-hair) solid var(--color-ink);
  }

  .post__service {
    margin-top: var(--space-lg);
    color: var(--color-muted);
  }

  .others {
    padding: 0;
    list-style: none;
    border-top: var(--rule-hair) solid var(--color-ink);
  }

  .others li {
    display: grid;
    gap: var(--space-2xs);
    padding-block: var(--space-md);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .others a {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    text-decoration: none;
  }

  .others a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
  }

  .others span {
    font-size: var(--text-xs);
    color: var(--color-neutral);
  }

  @media (min-width: 64rem) {
    .related {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-2xl);
    }
  }
</style>
